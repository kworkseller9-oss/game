# Строка подключения из Neon (Dashboard -> Connect -> Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Любая длинная случайная строка (минимум 32 символа)
JWT_SECRET=change-me-to-a-long-random-string

# Единственный админ. Создаётся автоматически при первом запросе к API.
# Если поменять пароль здесь и сделать redeploy, пароль админа обновится.
ADMIN_LOGIN=ibrohim
ADMIN_PASSWORD=change-me-strong-password

# Минимум игроков для старта (для тестов можно поставить 1-2)
MIN_PLAYERS=4
